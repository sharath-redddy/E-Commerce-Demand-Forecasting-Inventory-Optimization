      <aliases enabled='yes' />
      <column caption='Critical Products Count' datatype='integer' name='[Calculation_1017608424267776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Inventory_Status] = &quot;Critical&quot; THEN [product_id] END' />
      </column>
      <column caption='Attention Products' datatype='integer' name='[Calculation_1017608470839301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Inventory_Status] &lt;&gt; &quot;Healthy&quot;&#13;&#10;THEN [product_id]&#13;&#10;END' />
      </column>
      <column caption='One' datatype='integer' name='[Calculation_1017608661200902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Forecast Horizon' datatype='integer' name='[Calculation_1017609014669320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='12' />
      </column>
      <column caption='Forecasted Products' datatype='integer' name='[Calculation_1017609017282569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [period] = &quot;forecast&quot;&#13;&#10;THEN [product_id]&#13;&#10;END' />
      </column>
      <column caption='Total Products' datatype='integer' name='[Calculation_1017609047994378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([product_id])' />
      </column>
      <column caption='Inventory Health %' datatype='real' name='[Calculation_1017609094922251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Inventory_Status] = &quot;Healthy&quot;&#13;&#10;THEN [product_id]&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([product_id])' />
